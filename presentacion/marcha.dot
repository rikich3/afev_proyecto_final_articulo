  LIS [label="LISTO"]; PAR [label="PARADA_SOLICITADA"]; FAL [label="FALLO", fillcolor="#F2A0A0", color="#A02020"];
  MAR [label="MARCHA\nentry: contactor energizado", fillcolor="#F6C453", color="#B07A00", penwidth=3, fontsize=17];
  LIS -> MAR [label="start  [reset_pendiente ∧ seguro_para_listo]\n/ reset_pendiente := False\n  orden_contactor := True; alarma := False"];
